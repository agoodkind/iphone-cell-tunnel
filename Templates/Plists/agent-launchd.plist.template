<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>[[AGENT_MACH_SERVICE_NAME]]</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/[[AGENT_EXECUTABLE_NAME]]</string>
    <key>MachServices</key>
    <dict>
        <key>[[AGENT_MACH_SERVICE_NAME]]</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart only after an unclean exit. A clean exit is deliberate, either a
         logout or a stop the user asked for, and restarting it would undo the
         thing they just did. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- A failure that repeats on every launch, such as a revoked signature or a
         missing entitlement, would otherwise respawn forever on launchd's ten
         second default without the process living long enough to log why. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>[[AGENT_BUNDLE_ID]]</string>
    </array>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
